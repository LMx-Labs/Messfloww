{
  "rules": {
    "active_orders": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["userId", "paymentStatus"]
    },
    "menu_stock": {
      ".read": "auth != null",
      ".write": false,
      "$itemId": {
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "reserved": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        }
      }
    },
    "kot_queue": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$counterId": {
        ".indexOn": ["status"]
      }
    },
    "kot_counters": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "system_status": {
      ".read": "auth != null",
      "admin_online": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.token.email == 'lakshya.pms@gmail.com' || auth.token.email == 'samnagar@gmail.com')"
      }
    },
    "mess_status": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}

{
  "rules": {
    "active_orders": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["userId", "paymentStatus"]
    },
    "menu_stock": {
      ".read": "auth != null",
      ".write": false,
      "$itemId": {
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "kot_queue": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$counterId": {
        ".indexOn": ["status"]
      }
    },
    "kot_counters": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "system_status": {
      ".read": "auth != null",
      "admin_online": {
        ".write": "auth != null"
      }
    },
    "mess_status": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}

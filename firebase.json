            { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "kitchen",
      "public": "apps/inventory-kitchen/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
